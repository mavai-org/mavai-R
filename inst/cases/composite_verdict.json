    },
    {
      "name": "smoke_only_excluded_from_envelopes",
      "description": "A SMOKE run of two requirements, pass rate and latency, each decided by its SMOKE rule. Their alpha bounds a false FAIL and their PASS claims no compliance, so neither envelope is emitted (§1.4.6). The latency criterion FAILs, so the composite FAILs.",
      "inputs": {
        "criteria": [
          {
            "criterion_id": "c_policy_rate",
            "mode": "inferential",
            "procedure": "COMPLIANCE",
            "alpha": 0.05,
