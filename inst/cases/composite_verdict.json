      "expected": {
        "composite_verdict": "FAIL",
        "triggering_criteria": [
          "c_p95_latency"
        ],
        "false_compliance_envelope": null,
        "false_degradation_signal_envelope": null
      }
    },
    {
      "name": "smoke_beside_verification_and_regression",
      "description": "A SMOKE requirement beside a VERIFICATION requirement and a regression criterion. Only the VERIFICATION requirement enters the false-compliance envelope and only the regression criterion the false-degradation-signal envelope; the SMOKE criterion enters neither.",
      "inputs": {
