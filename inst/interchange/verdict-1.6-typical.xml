<!-- Worked example: a typical verdict-1.6 record.

     1.6 adds two things, both optional, so a 1.5-shaped record is a valid
     1.6 record.

     <inputs> states how each input the run drove presents itself. Every
     other interchange format has carried this; a verdict record could not,
     so a report named the document a failure came from by its index alone.
     Both inputs are named below, not only the one that misbehaved.

     @provenance on a standings row states which declaration stated the
     postcondition. The rows the criterion states carry "criterion" and are
     asserted against every input; the row input 1 states carries "input"
     and is judged only on the samples that input drove — which is why its
     denominator is the smaller one. Absence means "criterion".

     1.5 adds the failure kind. A <check> in the failure distribution may
     state whether those trials were judged and found wanting, or never
     delivered a response to judge; a delivery-kind check carries its cause
     in @name, drawn from the closed vocabulary (unreachable,
     client-deadline, peer-timeout, server-error, unusable-response). The
     attribute is optional and a 1.4-shaped check is a valid 1.5 check —
     absence means not stated, never "evaluated".

     The run below is the reason the distinction exists. Six of forty
     samples failed: four were delivered and did not state the premium
     amount, and two never answered before this framework's deadline. The
     arithmetic is unchanged — an undelivered trial is a failed trial
     against every criterion, as it always was — but a reader can now tell
     that the well-formedness criterion's two failures are the same two
     samples, and are not a quality finding at all. The standings say it a
     second way, per (input, check): those trials are skipped, because a
     check is judged against a response and there was none.

     1.4 adds structured standings rows: path/form/expected attributes
     beside the unchanged check identity, and <observed> obtained-value
     exemplar children (failing first, capped, elided remainder).
     A 1.3-shaped row remains valid — the structure is optional.

     1.3 adds the first-class <postcondition-standings> element: the
     descriptive per-(input, check) tally of per-trial check outcomes,
     with the partial-credit facts stated beside the counts — every row
     states whether its check is optional, and a criterion that declares
     an optional-check failure budget states it verbatim as authored. -->
<verdict-record xmlns="http://mavai.org/verdict/1.0" version="1.6" timestamp="2026-08-07T12:00:00+00:00" generator="worked-example">
  <identity use-case-id="offer-extraction" />
  <execution planned-samples="40" samples-executed="40" successes="34" failures="6" elapsed-ms="61800" intent="VERIFICATION" confidence="0.95" />
  <covariates aligned="true" />
  <inputs>
    <input index="0" excerpt="offer-letter-standard.pdf" />
    <input index="1" excerpt="offer-letter-amended.pdf" />
  </inputs>
  <provenance origin="UNSPECIFIED" />
  <termination reason="COMPLETED" />
  <environment>
    <entry key="sizing-approach" value="fixed-n" />
  </environment>
  <functional successes="34" failures="6" pass-rate="0.85">
    <failure-distribution>
      <check name="states the premium amount" count="4" kind="evaluated" />
      <!-- Not a check that did not hold: nothing was delivered to check.
           @name carries the cause, and @kind is what says to read it that
           way. The two trials count in every criterion's denominator. -->
      <check name="client-deadline" count="2" kind="delivery" />
    </failure-distribution>
  </functional>
  <postcondition-failures>
    <clause description="response does not state the premium amount" count="4" />
  </postcondition-failures>
  <per-criterion>
    <criterion id="extraction-matches-reviewed-values" verdict="FAIL" pass="34" fail="6" inconclusive="0" total="40" observed-rate="0.85" threshold="0.9" />
    <criterion id="response-well-formed" verdict="PASS" pass="38" fail="2" inconclusive="0" total="40" observed-rate="0.95" threshold="0.5" />
    <composite value="FAIL" />
  </per-criterion>
  <postcondition-standings>
    <criterion name="extraction-matches-reviewed-values" optional-slack="2">
      <row input-index="0" check="states the offer id" provenance="criterion" optional="false" passed="19" failed="0" skipped="1" observed-fraction="0.95" />
      <row input-index="0" check="states the premium amount" provenance="criterion" optional="false" passed="17" failed="2" skipped="1" observed-fraction="0.85" />
      <row input-index="0" check="lists the applicable terms" provenance="criterion" optional="true" passed="11" failed="8" skipped="1" observed-fraction="0.55" path="$.applicableTerms" form="equals-set" expected="[&quot;storm&quot;, &quot;hail&quot;, &quot;flood&quot;]" elided="2">
        <observed excerpt="[&quot;storm&quot;, &quot;hail&quot;]" count="6" held="false" />
        <observed excerpt="[]" count="2" held="false" />
        <observed excerpt="[&quot;storm&quot;, &quot;hail&quot;, &quot;flood&quot;]" count="9" held="true" />
      </row>
      <row input-index="1" check="states the offer id" provenance="criterion" optional="false" passed="19" failed="0" skipped="1" observed-fraction="0.95" />
      <row input-index="1" check="states the premium amount" provenance="criterion" optional="false" passed="17" failed="2" skipped="1" observed-fraction="0.85" />
      <row input-index="1" check="lists the applicable terms" provenance="criterion" optional="true" passed="12" failed="6" skipped="2" observed-fraction="0.6" />
      <row input-index="1" check="equals-set [&quot;7731-B&quot;] at $.offerId (input 1)" provenance="input" optional="false" passed="18" failed="1" skipped="1" observed-fraction="0.9" path="$.offerId" form="equals-set" expected="[&quot;7731-B&quot;]" />
    </criterion>
    <criterion name="response-well-formed">
      <row input-index="0" check="parses as json" provenance="criterion" optional="false" passed="19" failed="0" skipped="1" observed-fraction="0.95" />
      <row input-index="1" check="parses as json" provenance="criterion" optional="false" passed="19" failed="0" skipped="1" observed-fraction="0.95" />
    </criterion>
  </postcondition-standings>
  <verdict value="FAIL" />
</verdict-record>
