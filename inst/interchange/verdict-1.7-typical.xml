<!-- Worked example: a typical verdict-1.7 record.

     1.7 names the decision behind the verdict (Statistical Companion
     1.5.0). The record states the methodology whose rules produced it, and
     the verdict states the versioned rule that decided.

     The run below is an empirical regression test: a baseline of 951
     successes in 1000 trials, a test of 100 samples, alpha 0.05. Under
     regression/fisher (the one-sided Fisher exact test) the baseline and
     the test are weighed jointly, and the integer cutoff is c = 91: the
     test PASSes iff at least 91 of its 100 samples succeed. It observed 93, so it passes. The stated
     threshold is c / n_t = 0.91, the rate the cutoff corresponds to; the
     Wilson lower bound is descriptive and decides nothing.

     The statistics element names two powers apart at the design
     alternative rate 0.90: the design power (0.550), with the baseline
     and the test both yet to be drawn, and the power of this resolved
     test (0.549), whose cutoff the observed baseline fixed. The size at
     the assumed common rate 0.951 is 0.0340, the procedure's
     false-degradation-signal probability were the common rate the
     baseline's observed rate.

     The test also carries two explicit latency requirements over its 93
     successful latencies. p90 <= 800 ms is enforced (strict) and decided
     by latency/compliance-exact-binomial: 91 of the 93 latencies are at
     or below 800 ms, and at alpha 0.05 at least 89 must be for compliance
     to be demonstrated, so it passes. p99 <= 900 ms is advisory: the
     observed p99 is compared with the threshold, the breach is a warning,
     and it does not enter the verdict.

     A configuration refused before any sample ran is shown in
     verdict-1.7-refused.xml. -->
<verdict-record xmlns="http://mavai.org/verdict/1.0" version="1.7" methodology-version="1.5.0" timestamp="2026-09-26T12:00:00+00:00" generator="worked-example">
  <identity use-case-id="offer-extraction" />
  <execution planned-samples="100" samples-executed="100" successes="93" failures="7" elapsed-ms="148200" intent="VERIFICATION" confidence="0.95" />
  <statistics confidence-level="0.95" standard-error="0.0255" wilson-lower="0.8757" threshold="0.91" threshold-origin="EMPIRICAL" size-at-assumed-common-rate="0.0340" design-alternative-rate="0.90" design-power="0.550" resolved-test-power="0.549" />
  <covariates aligned="true" />
  <inputs>
    <input index="0" excerpt="offer-letter-standard.pdf" />
    <input index="1" excerpt="offer-letter-amended.pdf" />
  </inputs>
  <provenance origin="EMPIRICAL" />
  <baseline source-file="offer-extraction.baseline.yaml" generated-at="2026-09-20T09:30:00+00:00" samples="1000" baseline-rate="0.951" derived-threshold="0.91" />
  <termination reason="COMPLETED" />
  <functional successes="93" failures="7" pass-rate="0.93">
    <failure-distribution>
      <check name="states the premium amount" count="7" kind="evaluated" />
    </failure-distribution>
  </functional>
  <latency successful-samples="93" strict-violations="0" advisory-violations="1">
    <observed>
      <percentile label="p90" value-ms="640" />
      <percentile label="p99" value-ms="1400" />
    </observed>
    <evaluations>
      <evaluation percentile="p90" observed-ms="640" threshold-ms="800" provenance="explicit" mode="strict" status="PASS" decision-rule="latency/compliance-exact-binomial" decision-rule-version="1" within-threshold="91" required-within="89" />
      <evaluation percentile="p99" observed-ms="1400" threshold-ms="900" provenance="explicit" mode="advisory" status="ADVISORY_WARN" />
    </evaluations>
  </latency>
  <per-criterion>
    <criterion id="extraction-matches-reviewed-values" verdict="PASS" pass="93" fail="7" inconclusive="0" total="100" observed-rate="0.93" threshold="0.91" decision-rule="regression/fisher" decision-rule-version="1" />
    <composite value="PASS" />
  </per-criterion>
  <verdict value="PASS" decision-rule="regression/fisher" decision-rule-version="1" />
</verdict-record>
